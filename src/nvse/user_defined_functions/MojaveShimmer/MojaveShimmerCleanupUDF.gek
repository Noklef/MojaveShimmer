string_var sSavePath ; We need to keep {sSavePath} since PreLoadGame calls it with that argument
begin function {sSavePath}
    ; https://geckwiki.com/index.php?title=MarkForDelete
    ; https://geckwiki.com/index.php?title=AuxiliaryVariableErase

    ref rHazeBase   ; Our custom activator we clone with the heat mesh assigned to it
    ref rHaze       ; The actual haze object

    ; clear the read-only MCM Stats stuff before we load the save
    player.AuxVarErase "*_MojaveShimmer.Info.TimeFactor"
    player.AuxVarErase "*_MojaveShimmer.Info.IncomingShimmer"
    player.AuxVarErase "*_MojaveShimmer.Info.OutgoingShimmer"
    player.AuxVarErase "*_MojaveShimmer.Info.ShimmerIntensity"
    player.AuxVarErase "*_MojaveShimmer.Info.BaseRefractionStrength"
    player.AuxVarErase "*_MojaveShimmer.Info.RefractionStrength"

    ; Get the 2 references we need to clean up the haze effect
    let rHazeBase := player.AuxVarGetRef "*_MojaveShimmer.Base"
    let rHaze := player.AuxVarGetRef "*_MojaveShimmer.Ref"

    ; Discard the reference for cleanup
    player.AuxVarErase "*_MojaveShimmer.Ref"

    ; There's like 7 things to check, so i put it into 3 else ifs
    if eval !rHaze || !(IsReference rHaze) ; If haze doesn't exist, or isn't a reference
        return
    elseif eval !rHazeBase || (rHaze.GetBaseObject) != rHazeBase ; If the activator doesn't exist, or it's not based on the haze we created
        return
    elseif eval (rHaze.AuxVarGetFlt "*_MojaveShimmer.Owner") != 1 ; If the haze isn't owned by us
        return
    endif

    ; Disable the haze if it isn't already
    rHaze.Disable
    ; Remove its persistence
    rHaze.SetPersistent 0 
    ; Delte the owner flag
    rHaze.AuxVarErase "*_MojaveShimmer.Owner" 
    ; Mark it for deletion
    rHaze.MarkForDelete
end
