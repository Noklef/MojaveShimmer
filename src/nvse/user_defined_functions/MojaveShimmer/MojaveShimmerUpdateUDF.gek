begin function {}
    ;   GECK wiki stuff:
    ;   - https://geckwiki.com/index.php?title=GetCurrentWeatherPercent
    ;   - https://geckwiki.com/index.php?title=GetOutgoingWeather
    ;   - https://geckwiki.com/index.php?title=GetCurrentWeather
    ;   - https://geckwiki.com/index.php?title=GetWeatherTraitNumeric
    ;   - https://geckwiki.com/index.php/Sv_Construct

    ref rHaze           ; The actual haze object

    ref rWeatherIn      ; Current weather (or the one we're transitioning to)
    ref rWeatherOut     ; Weather we're transitioning from
    int bAllWeathers    ; INI toggle to ignore the weather completely, cached on the haze object by setup
    ref rBlockList      ; Weathers that never get the haze, built by setup

    ; Pull out the values here from the script; since we're reading these in MCM now
    float fIncomingShimmer = 0
    float fOutgoingShimmer = 0
    float fTimeFactor = 0
    float fShimmerIntensity = 0
    float fBaseRefractionStrength = 0
    float fRefractionStrength = 0

    ; Created haze object reference
    let rHaze := player.AuxVarGetRef "*_MojaveShimmer.Ref"

    ; IF there's no heat haze (disabled for instance), We remove the variables that were crated (if any)
    if eval !rHaze || !(IsReference rHaze)
        player.AuxVarErase "*_MojaveShimmer.Info.TimeFactor"
        player.AuxVarErase "*_MojaveShimmer.Info.IncomingShimmer"
        player.AuxVarErase "*_MojaveShimmer.Info.OutgoingShimmer"
        player.AuxVarErase "*_MojaveShimmer.Info.ShimmerIntensity"
        player.AuxVarErase "*_MojaveShimmer.Info.BaseRefractionStrength"
        player.AuxVarErase "*_MojaveShimmer.Info.RefractionStrength"
        return
    endif

    fBaseRefractionStrength = rHaze.AuxVarGetFlt "*_MojaveShimmer.Strength"

    ; If we're inside, or under water; then disable the effect
    ; Both checks, and the 0.875 (87.5% submerged), come from the original Heat Haze mod
    if eval player.IsInInterior || player.GetWaterImmersionPerc >= 0.875
        ; Hide it, if it isn't already
        if eval !rHaze.GetDisabled
            rHaze.Disable
        endif
    else
        let rWeatherIn := GetCurrentWeather ; Getting the current weather
        let rWeatherOut := GetOutgoingWeather ; Climate Control NVSE-specific weather function that the weather is tranferring from
        float fWeatherPct = GetCurrentWeatherPercent ; Getting % of transition

        ; fetch the data we need for checking
        let bAllWeathers := rHaze.AuxVarGetFlt "*_MojaveShimmer.AllWeathers"
        let rBlockList := player.AuxVarGetRef "*_MojaveShimmer.BlockList"

        ; Logic around figuring out the shimmer of the incoming weather change (I.E. weather we're transitioning to)
        if eval rWeatherIn ; safety check to ensure we're pulling the current weather
            ; First check, if we allow all weathers
            if eval bAllWeathers
                fIncomingShimmer = fWeatherPct
            ; A second check for if it's in the block list (-1 means not in list)
            elseif eval (IsRefInList rBlockList rWeatherIn) == -1
                ; Third check, figured out we can check a weather's wind speed
                if eval (GetWeatherTraitNumeric rWeatherIn 4) <= 0.5
                    fIncomingShimmer = (GetBit (GetWeatherTraitNumeric rWeatherIn 13) 0) * fWeatherPct
                endif
            endif
        endif

        ; Same logic as above, except for the outgoing weather (I.E. transitioning from)
        ; safety check for weather out reference + checking the outgoing weather transition isn't at 100% (changing still)
        if eval rWeatherOut && fWeatherPct < 1
            ; First check, same as fIncomingShimmer's
            if eval bAllWeathers
                fOutgoingShimmer = 1 - fWeatherPct
            ; A second check, same as fIncomingShimmer's
            elseif eval (IsRefInList rBlockList rWeatherOut) == -1
                ; Third check, same as fIncomingShimmer's
                if eval (GetWeatherTraitNumeric rWeatherOut 4) <= 0.5
                    fOutgoingShimmer = (GetBit (GetWeatherTraitNumeric rWeatherOut 13) 0) * (1 - fWeatherPct)
                endif
            endif
        endif

        ; se the time factor here in case of all times
        fTimeFactor = 1
        if eval !(rHaze.AuxVarGetFlt "*_MojaveShimmer.AllTimes")
            ; Get the values we need
            float fStartHour = rHaze.AuxVarGetFlt "*_MojaveShimmer.StartHour" 
            float fEndHour = rHaze.AuxVarGetFlt "*_MojaveShimmer.EndHour"
            float fFadeHours = rHaze.AuxVarGetFlt "*_MojaveShimmer.FadeHours"

            float fCurrentTime = GetCurrentTime
            fTimeFactor = 0
            if eval fCurrentTime > fStartHour && fCurrentTime < fEndHour ; If between the active hours
                if eval fCurrentTime < fStartHour + fFadeHours ; Morning transition, start hour plus the fade
                    fTimeFactor = (fCurrentTime - fStartHour) / fFadeHours
                elseif eval fCurrentTime > fEndHour - fFadeHours ; Evening transition, end hour minus the fade
                    fTimeFactor = (fEndHour - fCurrentTime) / fFadeHours
                else
                    fTimeFactor = 1 ; as intense as it should be
                endif
            endif
        endif

        ; How strong the effect is right now from 0 -> 1, using the time factor to ramp it in
        fShimmerIntensity = (fOutgoingShimmer + fIncomingShimmer) * fTimeFactor

        ; Only show it when there's something to see; the 0.01 just stops it enabling at a strength of ~0
        if fShimmerIntensity > 0.01
            ; If it's disabled, enable it (feels hacky?)
            if rHaze.GetDisabled
                rHaze.Enable
            endif

            ; Hacky fix, re-apply the spread shale if it hasn't stuck (only call `setScale` when it's different)
            float fScale = rHaze.AuxVarGetFlt "*_MojaveShimmer.Scale"
            if eval fScale > 0 && (rHaze.GetScale) != fScale
                rHaze.SetScale fScale
            endif

            ; Setting up the hidden helper's texture controller to control refraction strength
            ; This is a bit of a hack tbh
            fRefractionStrength = fBaseRefractionStrength * fShimmerIntensity

            rHaze.SetTextureTransformKey "MojaveShimmerStrengthControl" 0 0 fRefractionStrength
            rHaze.SetTextureTransformKey "MojaveShimmerStrengthControl" 0 1 fRefractionStrength

            ; The helper's second texture controller shares keys with the shader's fire-period controller
            float fRefractionSpeed = (rHaze.AuxVarGetFlt "*_MojaveShimmer.Speed")
            rHaze.SetTextureTransformKey "MojaveShimmerStrengthControl" 1 0 fRefractionSpeed
            rHaze.SetTextureTransformKey "MojaveShimmerStrengthControl" 1 1 fRefractionSpeed

            ; IF we're debugging, show the wireframe outline (only read here, since this is the only place it's used)
            if eval (rHaze.AuxVarGetFlt "*_MojaveShimmer.Wireframe")
                rHaze.SetNifBlockFlag "MojaveShimmerDebugWireframe" 0 0
            endif

            ; This follows the player, but not the camera (?), so would third person break?
            rHaze.MoveTo player 0 0 0
            ; Copy also rotates with player, so we need to reset it  (test this)
            rHaze.SetAngleEx 0 0 0
        else
            ; Keep the object for reuse; hide it while conditions fail
            if eval !rHaze.GetDisabled
                rHaze.Disable
            endif
        endif
    endif

    ; Set the string values for display in MCM (can't be floats, so need to convert)
    player.AuxVarSetStr "*_MojaveShimmer.Info.TimeFactor" (Sv_Construct "%.2f" fTimeFactor)
    player.AuxVarSetStr "*_MojaveShimmer.Info.IncomingShimmer" (Sv_Construct "%.2f" fIncomingShimmer)
    player.AuxVarSetStr "*_MojaveShimmer.Info.OutgoingShimmer" (Sv_Construct "%.2f" fOutgoingShimmer)
    player.AuxVarSetStr "*_MojaveShimmer.Info.ShimmerIntensity" (Sv_Construct "%.2f" fShimmerIntensity)
    player.AuxVarSetStr "*_MojaveShimmer.Info.BaseRefractionStrength" (Sv_Construct "%.2f" fBaseRefractionStrength)
    player.AuxVarSetStr "*_MojaveShimmer.Info.RefractionStrength" (Sv_Construct "%.2f" fRefractionStrength)
end
