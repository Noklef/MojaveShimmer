begin function {}
    ; Dev notes for me:
    ;   This uses a player reference to get / set info. I.E. '*_MojaveShimmer'
    ;       - *: prefix is used as a "temp storage"
    ;       - _: prefix is used as a "public storage", which is shared.
    ;       - MojaveShimmer: used as the "namespace" for this mod
    ;   GECK wiki stuff:
    ;       - https://geckwiki.com/index.php?title=AuxiliaryVariableSetFloat
    ;       - https://geckwiki.com/index.php/SetGameMainLoopCallback
    ;       - https://geckwiki.com/index.php?title=GetFormFromMod
    ;       - https://geckwiki.com/index.php?title=PlaceAtMe
    ;       - https://geckwiki.com/index.php?title=SetReferenceFlag

    ref rUpdate                 ; Update logic script reference (compiled)
    ref rCleanup                ; Cleanup logic script reference (compiled)

    ref rBlockList              ; Weathers that never get the haze, even when they're flagged Pleasant

    ref rTemplate               ; The base we clone for the heat haze effect (NelsonsLightBeamAct)
    ref rHazeBase               ; Our custom activator we clone with the heat mesh assigned to it
    ref rHaze                   ; The actual haze object
    float fScale                ; Scale that's calculated from the haze spread
    float fRefractionStrength   ; Refraction strength supplied to the NIF controller
    float fRefractionSpeed      ; Refraction speed supplied to the NIF controller

    int bEnabled                    ; INI - Enable / Disable the mod
    int bFallout3                   ; INI - Enable / Disable F03 (TTW)
    int bWireframe                  ; INI - Enable / Disable the debug wireframe
    int bAllWeathers                ; INI - Ignore the weather (Pleasant flag + block list)
    int bAllTimes                   ; INI - Ignore the time of day
    float fHazeDistance             ; INI - How far away the haze starts
    float fHazeIntensityMultiplier  ; INI - Haze strength
    float fStartHour                ; INI - The hour the haze starts fading in
    float fEndHour                  ; INI - The hour the haze has fully faded out
    float fFadeHours                ; INI - How many hours the fade in / out takes
    float fHazeSpread               ; HazeDistance / 50 - used for scaling

    ; ==============================================
    ; Script Compilation Checking / Reference Saving
    ; ==============================================

    ; Compile & check the update function
    let rUpdate := CompileScript "MojaveShimmer/MojaveShimmerUpdateUDF.gek"
    if eval !rUpdate
        Print "[MojaveShimmer] Can't compile 'MojaveShimmerUpdateUDF' for some reason, stopping script."
        return
    endif

    ; Stop the update loop while we (re)do setup
    player.SetGameMainLoopCallback rUpdate 0

    ; Compile & check the cleanup function 
    let rCleanup := CompileScript "MojaveShimmer/MojaveShimmerCleanupUDF.gek"
    if eval !rCleanup
        Print "[MojaveShimmer] Can't compile 'MojaveShimmerCleanupUDF' for some reason, stopping script."
        return
    endif

    ; Register the cleanup script to run before loading a save
    SetEventHandler "PreLoadGame" rCleanup

    ; Hook the MCMExtUpdate event, which re-applies the settings
    SetEventHandler "MCMExtUpdate" (CompileScript "MojaveShimmer/MojaveShimmerMCMUpdateUDF.gek")

    ; Checking if we need to disable the mod, and if so run the disable script
    let bEnabled := (GetINIString "General:bEnabled" "MojaveShimmer.ini") != "0"
    if eval !bEnabled
        call (CompileScript "MojaveShimmer/MojaveShimmerDisableUDF.gek")
        return
    endif

    ; =======================
    ; INI Fetching / Checking
    ; =======================

    let fHazeDistance := GetINIFloat "Settings:HazeDistance" "MojaveShimmer.ini"
    ; Only check if the heat haze is a negative number or 0
    if eval fHazeDistance <= 0
        let fHazeDistance := 50 ; Use the default if missing or not a positive distance
    endif

    ; Originally were doing 1:1, but now with MCM we need to divide it by 50 (since the cylinder model defaults to 50m)
    let fHazeSpread := fHazeDistance / 50

    ; Only check if the intensity multiplier is a negative number or 0
    let fHazeIntensityMultiplier := GetINIFloat "Debug:HazeIntensityMultiplier" "MojaveShimmer.ini"
    if eval fHazeIntensityMultiplier <= 0
        let fHazeIntensityMultiplier := 1.00
    endif

    ; Only check if the refraction speed is a negative number or 0
    let fRefractionSpeed := GetINIFloat "Settings:RefractionSpeed" "MojaveShimmer.ini"
    if eval fRefractionSpeed <= 0
        let fRefractionSpeed := 0.5 ; Clamp to the MCM minimum
    endif

    ; Get the start hour from the INI, and set it to a default if invalid
    let fStartHour := GetINIFloat "Timing:StartHour" "MojaveShimmer.ini"
    if eval fStartHour <= 0
        let fStartHour := 6
    endif

    ; Get the end hour from the INI, and set it to a default if invalid
    let fEndHour := GetINIFloat "Timing:EndHour" "MojaveShimmer.ini"
    if eval fEndHour > 23
        let fEndHour := 19
    endif

    ; Reset both hours if the resulting range is invalid
    if eval fEndHour <= fStartHour
        let fStartHour := 6
        let fEndHour := 19
    endif

    ; Get the fade length from the INI, and set it to defaults if invalid
    let fFadeHours := GetINIFloat "Timing:FadeHours" "MojaveShimmer.ini"
    if eval (GetINIString "Timing:FadeHours" "MojaveShimmer.ini") == ""
        let fFadeHours := 2
    endif

    if eval fFadeHours < 0
        let fFadeHours := 0
    elseif eval fFadeHours > (fEndHour - fStartHour) / 2
        let fFadeHours := (fEndHour - fStartHour) / 2
    endif

    let bWireframe := (GetINIString "Debug:bWireframe" "MojaveShimmer.ini") == "1"
    let bAllWeathers := (GetINIString "Debug:bAllWeathers" "MojaveShimmer.ini") == "1"
    let bAllTimes := (GetINIString "Debug:bAllTimes" "MojaveShimmer.ini") == "1"
    let bFallout3 := (GetINIString "General:bFallout3" "MojaveShimmer.ini") == "1"

    ; ==================
    ; Weather Block List
    ; ==================

    ; Set-up a block list of weathers we're don't want the effect to trigger on
    let rBlockList := player.AuxVarGetRef "*_MojaveShimmer.BlockList"
    if eval !rBlockList || (GetType rBlockList) != 85 ; 85 is the FormList type

        let rBlockList := CreateFormList
        if eval !rBlockList
            Print "[MojaveShimmer] Can't create the weather block list, stopping script."
            return
        endif

        ; Storing the list for the update function
        player.AuxVarSetRef "*_MojaveShimmer.BlockList" rBlockList
    endif

    ; MCM Re-runs the whole script, so we now have to empty it and re-add all the things once it does (Since now FO3 can be toggled on / off)
    ListClear rBlockList

    ; Codes from FNVEdit's Editor IDs, adding to the FormList
    ListAddForm rBlockList (GetFormFromMod "FalloutNV.esm" "1538FA") ; NVWastelandClearTest
    ListAddForm rBlockList (GetFormFromMod "FalloutNV.esm" "1689F2") ; NVWastelandClearTest2
    ListAddForm rBlockList (GetFormFromMod "FalloutNV.esm" "169BD4") ; NVWastelandInterior
    ListAddForm rBlockList (GetFormFromMod "FalloutNV.esm" "15E5CF") ; NVSewerWeather
    ListAddForm rBlockList (GetFormFromMod "FalloutNV.esm" "15E5D0") ; NVSewerSkyPlaneWeather
    ListAddForm rBlockList (GetFormFromMod "FalloutNV.esm" "164BA4") ; NVJacobstownWeather
    ListAddForm rBlockList (GetFormFromMod "FalloutNV.esm" "16198A") ; NVBlackMountainWeather
    ListAddForm rBlockList (GetFormFromMod "FalloutNV.esm" "17407F") ; NVHooverFinalBattle
    ListAddForm rBlockList (GetFormFromMod "FalloutNV.esm" "173FF3") ; NVHooverBattleWeather
    ListAddForm rBlockList (GetFormFromMod "FalloutNV.esm" "15E") ; DefaultWeather - just in case

    ; DLC weathers, only added when that DLC is loaded
    if eval IsModLoaded "OldWorldBlues.esm"
        ListAddForm rBlockList (GetFormFromMod "OldWorldBlues.esm" "00E57F") ; NVDLC03BigMTWeather
    endif
    if eval IsModLoaded "LonesomeRoad.esm"
        ListAddForm rBlockList (GetFormFromMod "LonesomeRoad.esm" "002CE5") ; NVDLC04DivideWeather
    endif

    ; FNV apparently has FO3 leftover weathers (not all though), and TTW uses those, so have to specify them here
    ListAddForm rBlockList (GetFormFromMod "FalloutNV.esm" "017906") ; SuburbanCloudy
    ListAddForm rBlockList (GetFormFromMod "FalloutNV.esm" "054E1D") ; WastelandEastOasis
    ListAddForm rBlockList (GetFormFromMod "FalloutNV.esm" "092BC6") ; DLC01PittWthrBridge01
    ListAddForm rBlockList (GetFormFromMod "FalloutNV.esm" "092BC2") ; DLC01PittWthrBasic01
    ListAddForm rBlockList (GetFormFromMod "FalloutNV.esm" "092BC5") ; DLC01PittWthrUptown01

    ; DLC weathers' we're blocking these since they don't really fit the haze
    if eval IsModLoaded "Anchorage.esm"
        ListAddForm rBlockList (GetFormFromMod "Anchorage.esm" "0022E4") ; DLC02AnchWthrClear01 - snow
        ListAddForm rBlockList (GetFormFromMod "Anchorage.esm" "00CCCF") ; DLC02AnchWthrOverlook
        ListAddForm rBlockList (GetFormFromMod "Anchorage.esm" "00C3F0") ; DLC02AnchWthrPreDawn02
    endif
    if eval IsModLoaded "PointLookout.esm"
        ListAddForm rBlockList (GetFormFromMod "PointLookout.esm" "003123") ; DLC04PointLookoutBoardwalkWthr - swamp / coast
        ListAddForm rBlockList (GetFormFromMod "PointLookout.esm" "0113F0") ; DLC04PointLookoutLighthouseWthr
        ListAddForm rBlockList (GetFormFromMod "PointLookout.esm" "004234") ; DLC04PointLookoutMarshWthr
    endif

    ; If FO3 is toggled off, block these as well
    if eval !bFallout3
        ListAddForm rBlockList (GetFormFromMod "FalloutNV.esm" "064609") ; WastelandClear
        ListAddForm rBlockList (GetFormFromMod "FalloutNV.esm" "05A728") ; WastelandDecay
        ListAddForm rBlockList (GetFormFromMod "FalloutNV.esm" "03D43B") ; WastelandEast
        ListAddForm rBlockList (GetFormFromMod "FalloutNV.esm" "054E12") ; WastelandClearMegaton
        ListAddForm rBlockList (GetFormFromMod "FalloutNV.esm" "06A076") ; MegatonFalloutDecay
        ListAddForm rBlockList (GetFormFromMod "FalloutNV.esm" "092BC7") ; DLC01PittWthrSteelYard02
        ListAddForm rBlockList (GetFormFromMod "FalloutNV.esm" "02BF97") ; TranquilityClear
        if eval IsModLoaded "BrokenSteel.esm"
            ListAddForm rBlockList (GetFormFromMod "BrokenSteel.esm" "008A0D") ; DLC03AAFBWeather - Adams AFB
        endif
    endif

    ; ==============================
    ; Haze Reference Setup / Caching
    ; ==============================

    ; Get the cached base for reference firstly
    let rHazeBase := player.AuxVarGetRef "*_MojaveShimmer.Base"

    ; If we don't have it set-up already / not valid / not cloned, then we create it
    if eval !rHazeBase || (GetType rHazeBase) != 21 || !(IsClonedForm rHazeBase)

        ; 15182D is NelsonsLightBeamAct, this doesn't have anything meaninful attached, so we can use it as the template
        ; Need to copy since we're ESPless
        let rTemplate := GetFormFromMod "FalloutNV.esm" "15182D" ; 
        
        ; If for some reason it has a script already, or isn't an activator
        if eval (GetType rTemplate) != 21 || (GetScript rTemplate) 
            Print "[MojaveShimmer] The template (15182D) either has a script or isn't an activator, stopping script."
            return
        endif

        ; Cloning the template we've grabbed from NelsonsLightBeamAct (for the heat haze effect)
        let rHazeBase := TempCloneForm rTemplate
        if eval !rHazeBase
            Print "[MojaveShimmer] Couldn't clone the template we need, stopping script. "
            return
        endif
        
        ; Check if we have the model file
        if eval !(SetModelPath "mojaveshimmer\mojaveshimmer_cylinder.nif" rHazeBase)
            Print "[MojaveShimmer] Can't find the heat haze model file, stopping script."
            return
        endif

        ; Give the object a name, so clicking it with the console open doesn't just show the HEX value
        SetName "Mojave Shimmer" rHazeBase

        ; Storing the haze base in the reference so we can re-use it later on
        player.AuxVarSetRef "*_MojaveShimmer.Base" rHazeBase
    endif

    ; Fetching the cache'd object we setup before, and check if we got anything from it
    let rHaze := player.AuxVarGetRef "*_MojaveShimmer.Ref"
    if eval rHaze
        ; Check if the reference is valid (if not we need to create it again, setting it to 0)
        if eval !(IsReference rHaze)
            let rHaze := 0
        ; Check if it's been modified outside of this script, and check if it's been deleted (32 = Deleted flag)
        elseif eval (rHaze.GetBaseObject) != rHazeBase || (rHaze.GetRefFlag 32)
            let rHaze := 0
        endif
    endif

    ; If It hasn't been created yet, we need to create it and set it for use
    if eval !rHaze
        ; Place 1 copy on the player
        let rHaze := player.PlaceAtMe rHazeBase 1
        if eval !rHaze
            Print "[MojaveShimmer] Can't create the heat haze reference near the player, stopping script."
            return
        endif

        ; Set the object to be owned, for the cleanup function to check it doesn't delete something we didn't create
        rHaze.AuxVarSetFlt "*_MojaveShimmer.Owner" 1
        ; Keep it persistent across cell changes
        rHaze.SetPersistent 1

        ; Setting the angle, and disabling intraction including collission (similar to how the original did)
        rHaze.SetAngleEx 0 0 0
        rHaze.SetInteractionDisabled 1
        rHaze.ToggleObjectCollision 0

        ; Testing. This is for reflecting water, but might be just broken
        rHaze.SetRefFlag 268435456 0
        rHaze.SetRefFlag 536870912 0

        ; Store the reference for later use
        player.AuxVarSetRef "*_MojaveShimmer.Ref" rHaze
    endif

    ; Hide during setup. The update function enables it on weather / time conditions
    rHaze.Disable

    ; ===============
    ; Variable saving
    ; ===============

    ; Set the scale to the haze spread
    let fScale := fHazeSpread
    
    ; Store it so the update function can re-apply it if it doesn't stick while disabled / in menus
    rHaze.AuxVarSetFlt "*_MojaveShimmer.Scale" fScale
    rHaze.SetScale fScale

    ; Calculating the refreraction strength
    let fRefractionStrength := 0.4 * fHazeSpread * fHazeIntensityMultiplier
    
    ; Set the strength to 1 if it's greater, since the nif can't have a higher than a value of 1 for the refraction
    if eval fRefractionStrength > 1
        let fRefractionStrength := 1
    endif
    rHaze.AuxVarSetFlt "*_MojaveShimmer.Strength" fRefractionStrength

    rHaze.AuxVarSetFlt "*_MojaveShimmer.Speed" fRefractionSpeed

    ; Store the timing settings for the update function
    rHaze.AuxVarSetFlt "*_MojaveShimmer.StartHour" fStartHour
    rHaze.AuxVarSetFlt "*_MojaveShimmer.EndHour" fEndHour
    rHaze.AuxVarSetFlt "*_MojaveShimmer.FadeHours" fFadeHours

    ; Store the debug option for the update function
    rHaze.AuxVarSetFlt "*_MojaveShimmer.Wireframe" bWireframe
    rHaze.AuxVarSetFlt "*_MojaveShimmer.AllWeathers" bAllWeathers
    rHaze.AuxVarSetFlt "*_MojaveShimmer.AllTimes" bAllTimes

    ; Hide it here so the debug off via MCM doesn't leave it showing
    rHaze.SetNifBlockFlag "MojaveShimmerDebugWireframe" 0 1

    ; Register it (we only get here when enabled, see the bEnabled check at the top)
    ; Call it every frame, and 1 + 8 (run during gameplay + remove on load or main menu)
    player.SetGameMainLoopCallback rUpdate 1 1 9
end
