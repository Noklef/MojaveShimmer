begin function {}
    ref rHaze   ; The actual haze object

    ; clear the read-only MCM Stats stuff when the mod is disabled
    player.AuxVarErase "*_MojaveShimmer.Info.TimeFactor" "0.00"
    player.AuxVarErase "*_MojaveShimmer.Info.IncomingShimmer" "0.00"
    player.AuxVarErase "*_MojaveShimmer.Info.OutgoingShimmer" "0.00"
    player.AuxVarErase "*_MojaveShimmer.Info.ShimmerIntensity" "0.00"
    player.AuxVarErase "*_MojaveShimmer.Info.BaseRefractionStrength" "0.00"
    player.AuxVarErase "*_MojaveShimmer.Info.RefractionStrength" "0.00"
    
    ; Created haze object reference
    let rHaze := player.AuxVarGetRef "*_MojaveShimmer.Ref"

    ; Don't disable if the haze doesn't exist, or isn't a reference
    if eval !rHaze || !(IsReference rHaze)
        return
    endif

    ; Disable the haze if it isn't already
    if eval !rHaze.GetDisabled
        rHaze.Disable
    endif
end
