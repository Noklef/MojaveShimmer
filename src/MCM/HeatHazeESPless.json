{
    "modName": "HeatHazeESPless",
    "displayName": "Heat Haze - ESPless",
    "saveFile": "HeatHaze-ESPless.ini",
    "minMCMVersion": 1.0,
    "requirements": [
        { "type": "file", "file": "nvse/plugins/scripts/ln_HeatHazeESPless.txt" }
    ],
    "submenus": {
        "0": {
            "listTitle": "Settings",
            "pageTitle": "Heat Haze Settings",
            "active": 1,
            "columns": 1,
            "enable": 1,
            "options": {
                "1": {
                    "title": "Enable Heat Haze",
                    "enable": 1,
                    "type": 5,
                    "mouse": "Enable or disable the heat haze.",
                    "vars": [
                        { "configINI": "General:bEnabled", "default": 1 }
                    ]
                },
                "2": {
                    "title": "Haze Spread Distance",
                    "enable": 1,
                    "type": 2.5,
                    "mouse": "Set the distance that the heat haze effect starts at. At further distances, increase the Intensity Multiplier",
                    "vars": [
                        { "configINI": "Settings:HazeSpread", "default": 1.0 }
                    ],
                    "scale": {
                        "valueDecimal": 2,
                        "valueIncrement": 0.5,
                        "valueMin": 0.5,
                        "valueMax": 2.5
                    }
                },
                "3": {
                    "title": "Haze Intensity Multiplier",
                    "enable": 1,
                    "type": 2.5,
                    "mouse": "Adjusts the strength of the distortion effect.",
                    "vars": [
                        { "configINI": "Settings:HazeIntensityMultiplier", "default": 1.0 }
                    ],
                    "scale": {
                        "valueDecimal": 2,
                        "valueIncrement": 0.1,
                        "valueMin": 0.5,
                        "valueMax": 2.5
                    }
                },
                "4": {
                    "title": "Debug Mode",
                    "enable": 1,
                    "type": 5,
                    "mouse": "Shows a green outline for the haze effect, to see the distance it appears at + the strength of it.",
                    "vars": [
                        { "configINI": "Debug:bDebug", "default": 0 }
                    ]
                }
            }
        }
    }
}
