{
    "modName": "MojaveShimmer",
    "displayName": "Mojave Shimmer",
    "saveFile": "MojaveShimmer.ini",
    "minMCMVersion": 1.0,
    "requirements": [
        { "type": "file", "file": "nvse/plugins/scripts/ln_MojaveShimmer.txt" }
    ],
    "submenus": {
        "1": {
            "listTitle": "Settings",
            "pageTitle": "Mojave Shimmer - Settings",
            "active": 1,
            "columns": 2,
            "enable": 1,
            "options": {
                "1": {
                    "title": "General",
                    "enable": 1,
                    "type": 0
                },
                "3": {
                    "title": "Enable Mojave Shimmer",
                    "enable": 1,
                    "type": 5,
                    "mouse": "Enable / Disable Mojave Shimmer entirely.",
                    "vars": [
                        { "configINI": "General:bEnabled", "default": 1 }
                    ]
                },
                "4": {
                    "title": "Fallout 3 Areas (TTW)",
                    "enable": 1,
                    "type": 5,
                    "mouse": "(Hasn't been fully tested) Enable the haze effect in areas in FO3 & the DLC's. Results may vary.",
                    "vars": [
                        { "configINI": "General:bFallout3", "default": 0 }
                    ],
                    "state": { "configINI": "General:bEnabled", "default": 1, "value": 1, "disable": 1 }
                },
                "7": {
                    "title": "Haze",
                    "enable": 1,
                    "type": 0
                },
                "8": {
                    "title": "Timing",
                    "enable": 1,
                    "type": 0
                },
                "9": {
                    "title": "Spread Distance",
                    "enable": 1,
                    "type": 2,
                    "mouse": "How far from you the heat haze starts. The strength scales up with the distance to make up for it.",
                    "vars": [
                        { "configINI": "Settings:HazeDistance", "default": 50 }
                    ],
                    "state": { "configINI": "General:bEnabled", "default": 1, "value": 1, "disable": 1 },
                    "scale": {
                        "valueDecimal": 0,
                        "valueIncrement": 10,
                        "valueMin": 50,
                        "valueMax": 100,
                        "suffix": "m"
                    },
                    "suffix": "m"
                },
                "10": {
                    "title": "Haze Starts",
                    "enable": 1,
                    "type": 2,
                    "mouse": "Hour when the heat haze starts fading in.",
                    "vars": [
                        { "configINI": "Timing:StartHour", "default": 6 }
                    ],
                    "scale": {
                        "valueDecimal": 0,
                        "valueIncrement": 1,
                        "valueMin": 5,
                        "valueMax": 11,
                        "suffix": ":00"
                    },
                    "suffix": ":00",
                    "state": { "configINI": "General:bEnabled", "default": 1, "value": 1, "disable": 1 }
                },
                "11": {
                    "title": "Refraction Speed Modifier",
                    "enable": 1,
                    "type": 2,
                    "mouse": "Controls how quickly the heat shimmer... shimmers",
                    "vars": [
                        { "configINI": "Settings:RefractionSpeed", "default": 1 }
                    ],
                    "state": { "configINI": "General:bEnabled", "default": 1, "value": 1, "disable": 1 },
                    "scale": {
                        "valueDecimal": 1,
                        "valueIncrement": 0.1,
                        "valueMin": 0.5,
                        "valueMax": 2.5
                    }
                },
                "12": {
                    "title": "Haze Ends",
                    "enable": 1,
                    "type": 2,
                    "mouse": "Hour when the heat haze has fully faded out.",
                    "vars": [
                        { "configINI": "Timing:EndHour", "default": 19 }
                    ],
                    "scale": {
                        "valueDecimal": 0,
                        "valueIncrement": 1,
                        "valueMin": 12,
                        "valueMax": 20,
                        "suffix": ":00"
                    },
                    "suffix": ":00",
                    "state": { "configINI": "General:bEnabled", "default": 1, "value": 1, "disable": 1 }
                },
                "14": {
                    "title": "Fade Length",
                    "enable": 1,
                    "type": 2.5,
                    "mouse": "How long the effect takes to fade in at the start, and out at the end.",
                    "vars": [
                        { "configINI": "Timing:FadeHours", "default": 2.0 }
                    ],
                    "scale": {
                        "valueDecimal": 1,
                        "valueIncrement": 0.5,
                        "valueMin": 0,
                        "valueMax": 4,
                        "suffix": "h"
                    },
                    "suffix": "h",
                    "state": { "configINI": "General:bEnabled", "default": 1, "value": 1, "disable": 1 }
                }
            }
        },
        "2": {
            "listTitle": "Debug",
            "pageTitle": "Mojave Shimmer - Debug",
            "columns": 1,
            "enable": 1,
            "options": {
                "1": {
                    "title": "Show Wireframe",
                    "enable": 1,
                    "type": 5,
                    "mouse": "Shows a green outline for the haze effect. This is the distance the haze will appear.",
                    "vars": [
                        { "configINI": "Debug:bWireframe", "default": 0 }
                    ],
                    "state": { "configINI": "General:bEnabled", "default": 1, "value": 1, "disable": 1 }
                },
                "2": {
                    "title": "All Weathers",
                    "enable": 1,
                    "type": 5,
                    "mouse": "Shows the heat haze in every weather, ignoring the weather checks.",
                    "vars": [
                        { "configINI": "Debug:bAllWeathers", "default": 0 }
                    ],
                    "state": { "configINI": "General:bEnabled", "default": 1, "value": 1, "disable": 1 }
                },
                "3": {
                    "title": "All Times",
                    "enable": 1,
                    "type": 5,
                    "mouse": "Shows the heat haze at every time of day, ignoring the Timing settings.",
                    "vars": [
                        { "configINI": "Debug:bAllTimes", "default": 0 }
                    ],
                    "state": { "configINI": "General:bEnabled", "default": 1, "value": 1, "disable": 1 }
                },
                "4": {
                    "title": "Intensity Multiplier",
                    "enable": 1,
                    "type": 2.5,
                    "mouse": "Adjusts the strength of the distortion effect, on top of the automatic scaling with Spread Distance.",
                    "vars": [
                        { "configINI": "Debug:HazeIntensityMultiplier", "default": 1.0 }
                    ],
                    "state": { "configINI": "General:bEnabled", "default": 1, "value": 1, "disable": 1 },
                    "scale": {
                        "valueDecimal": 2,
                        "valueIncrement": 0.1,
                        "valueMin": 0.5,
                        "valueMax": 2.5
                    }
                }
            }
        }
    }
}
